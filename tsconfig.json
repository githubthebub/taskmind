{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "outFile": "dist/app.js",
    "rootDir": "src",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "removeComments": false,
    "newLine": "lf"
  },
  "files": [
    "src/types.ts",
    "src/storage.ts",
    "src/audio.ts",
    "src/engine.ts",
    "src/breathing.ts",
    "src/game.ts",
    "src/crucible.ts",
    "src/rewards.ts",
    "src/exit.ts",
    "src/main.ts"
  ]
}
